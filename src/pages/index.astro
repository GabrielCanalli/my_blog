---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const allPosts = [...featuredPosts, ...recentPosts];

// Obter os meses únicos dos posts para o arquivo do diário
const archivesMap = new Map();
allPosts.forEach(post => {
  const date = new Date(post.data.pubDatetime);
  const monthYear = date.toLocaleString('pt-BR', { month: 'long', year: 'numeric' });
  const formattedMonth = monthYear.charAt(0).toUpperCase() + monthYear.slice(1);
  archivesMap.set(formattedMonth, (archivesMap.get(formattedMonth) || 0) + 1);
});
const archives = Array.from(archivesMap.entries());
---

<Layout>
  <Header />
  
  <main id="main-content" class="app-layout py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      
      <!-- COLUNA ESQUERDA: Sidebar estilo Not A Blog -->
      <aside class="lg:col-span-1 space-y-6 order-2 lg:order-1">
        
        <!-- Bloco de Pesquisa -->
        <div class="p-4 border border-skin-line rounded bg-skin-card/50">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-3 text-skin-accent">
            Pesquisar no Blog
          </h3>
          <form action={getRelativeLocaleUrl(locale, "search")} method="get" class="flex gap-2">
            <input 
              type="text" 
              name="q" 
              placeholder="Pesquisar..." 
              class="w-full px-3 py-1.5 text-sm bg-skin-fill border border-skin-line rounded focus:outline-none focus:border-skin-accent"
            />
            <button type="submit" class="px-3 py-1.5 text-sm bg-skin-accent text-skin-inverted rounded font-medium hover:opacity-90">
              Ir
            </button>
          </form>
        </div>

        <!-- Bloco do Autor (Foto + Apresentação Aberta e Pessoal) -->
        <div class="p-4 border border-skin-line rounded bg-skin-card/50 text-center sm:text-left">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-3 text-skin-accent">
            Sobre o Autor
          </h3>
          
          {/* Caso queira colocar uma imagem de perfil no futuro, basta descomentar a linha abaixo */}
          {/* <img src="/assets/autor.jpg" alt="Gabriel Canalli Barbosa" class="w-full h-auto rounded border border-skin-line mb-3" /> */}

          <p class="text-xs leading-relaxed opacity-90 mb-4 text-justify">
            Este é o meu diário de bordo e portal pessoal. Aqui compartilho o processo de criação dos meus livros, bastidores de escrita, reflexões cotidianas e coisas que gosto.
          </p>
          
          {socials.length > 0 && <Socials />}
        </div>

        <!-- Bloco de Arquivos / Diário Mensal -->
        <div class="p-4 border border-skin-line rounded bg-skin-card/50">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-3 text-skin-accent">
            Arquivo / Diário
          </h3>
          <ul class="space-y-2 text-sm">
            {archives.map(([month, count]) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, "archives")} class="flex justify-between hover:text-skin-accent transition-colors">
                  <span>{month}</span>
                  <span class="opacity-60">({count})</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

      </aside>

      <!-- COLUNA DIREITA: Feed do Diário -->
      <section class="lg:col-span-3 space-y-12 order-1 lg:order-2">
        
        <!-- Cabeçalho Geral do Diário -->
        <div class="pb-6 border-b border-skin-line">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">
            Diário de Escrita & Notas
          </h1>
          <p class="text-base leading-relaxed opacity-90">
            Meu espaço pessoal para registrar a evolução das minhas histórias, ideias, opiniões e novidades.
          </p>
        </div>

        <!-- Feed de Posts -->
        <div class="space-y-10">
          {allPosts.map((post) => {
            const pubDate = new Date(post.data.pubDatetime);
            const formattedDate = pubDate.toLocaleDateString('pt-BR', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });

            return (
              <article class="pb-8 border-b border-skin-line/50 last:border-none">
                <header class="mb-3">
                  <h2 class="text-2xl font-bold hover:text-skin-accent transition-colors">
                    <a href={getRelativeLocaleUrl(locale, `posts/${post.id}`)}>
                      {post.data.title}
                    </a>
                  </h2>
                  <div class="text-xs uppercase tracking-wider opacity-70 mt-1 font-mono">
                    {formattedDate} {post.data.author ? `— por ${post.data.author}` : ''}
                  </div>
                </header>

                <div class="prose prose-invert max-w-none text-sm leading-relaxed opacity-90 mb-4">
                  <p>{post.data.description}</p>
                </div>

                <footer>
                  <a 
                    href={getRelativeLocaleUrl(locale, `posts/${post.id}`)}
                    class="inline-flex items-center text-xs font-semibold text-skin-accent hover:underline"
                  >
                    Continuar a ler &rarr;
                  </a>
                </footer>
              </article>
            );
          })}
        </div>

      </section>

    </div>
  </main>

  <Footer />
</Layout>
