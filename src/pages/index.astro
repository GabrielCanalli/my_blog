---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const allPosts = [...featuredPosts, ...recentPosts];

// Lógica do Calendário
const today = new Date();
const currentYear = today.getFullYear();
const currentMonth = today.getMonth();

const monthName = today.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
const formattedMonthName = monthName.charAt(0).toUpperCase() + monthName.slice(1);

const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();
const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

const postsByDay = new Map();
allPosts.forEach(post => {
  const pDate = new Date(post.data.pubDatetime);
  if (pDate.getFullYear() === currentYear && pDate.getMonth() === currentMonth) {
    const dayNum = pDate.getDate();
    postsByDay.set(dayNum, post);
  }
});

const calendarCells = [];
for (let i = 0; i < firstDayOfMonth; i++) {
  calendarCells.push(null);
}
for (let day = 1; day <= daysInMonth; day++) {
  calendarCells.push(day);
}
---

<Layout>
  <Header />
  
  <main id="main-content" class="app-layout py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      
      <!-- COLUNA ESQUERDA: Sidebar -->
      <aside class="lg:col-span-1 space-y-6 order-2 lg:order-1">
        
        <!-- Pesquisa -->
        <div class="p-4 border border-skin-line rounded bg-skin-card/50">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-3 text-skin-accent">
            Pesquisar no Blog
          </h3>
          <form action={getRelativeLocaleUrl(locale, "search")} method="get" class="flex gap-2">
            <input 
              type="text" 
              name="q" 
              placeholder="Pesquisar..." 
              class="w-full px-3 py-1.5 text-sm bg-skin-fill border border-skin-line rounded focus:outline-none focus:border-skin-accent"
            />
            <button type="submit" class="px-3 py-1.5 text-sm bg-skin-accent text-skin-inverted rounded font-medium hover:opacity-90">
              Ir
            </button>
          </form>
        </div>

       <!-- Sobre o Autor -->
<div class="p-4 border border-skin-line rounded bg-skin-card/50">
  <h3 class="text-sm font-semibold uppercase tracking-wider mb-3 text-skin-accent">
    Sobre o Autor
  </h3>
  
  <img 
    src="/autor.jpg" 
    alt="Gabriel Canalli Barbosa" 
    class="w-full h-auto rounded border border-skin-line mb-3 object-cover max-h-56" 
  />

  <p class="text-xs leading-relaxed opacity-90 mb-4 text-justify">
    Este é o meu diário de bordo e portal pessoal. Aqui compartilho o processo de criação dos meus livros, bastidores de escrita, reflexões cotidianas e ideias.
  </p>
  
  {socials.length > 0 && <Socials />}
</div>

        <!-- Calendário do Diário -->
        <div class="p-4 border border-skin-line rounded bg-skin-card/50">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-1 text-skin-accent text-center">
            {formattedMonthName}
          </h3>
          <p class="text-[10px] text-center opacity-60 mb-3 font-mono">DIÁRIO DE PUBLICAÇÃO</p>

          <div class="grid grid-cols-7 gap-1 text-center text-xs font-bold mb-2 opacity-70">
            <span>D</span><span>S</span><span>T</span><span>Q</span><span>Q</span><span>S</span><span>S</span>
          </div>

          <div class="grid grid-cols-7 gap-1 text-center text-xs font-mono">
            {calendarCells.map((day) => {
              if (day === null) {
                return <div class="py-1"></div>;
              }
              
              const post = postsByDay.get(day);
              const isToday = day === today.getDate();

              return (
                <div class={`py-1 rounded ${isToday ? 'border border-skin-accent' : ''}`}>
                  {post ? (
                    <a 
                      href={getRelativeLocaleUrl(locale, `posts/${post.id}`)}
                      title={post.data.title}
                      class="block font-bold text-skin-accent underline bg-skin-accent/10 rounded hover:bg-skin-accent hover:text-skin-inverted transition-colors"
                    >
                      {day}
                    </a>
                  ) : (
                    <span class="opacity-40">{day}</span>
                  )}
                </div>
              );
            })}
          </div>

          <div class="mt-4 pt-3 border-t border-skin-line/40 text-center">
            <a href={getRelativeLocaleUrl(locale, "archives")} class="text-xs text-skin-accent hover:underline">
              Ver Arquivo Completo &rarr;
            </a>
          </div>
        </div>

      </aside>

      <!-- COLUNA DIREITA: Feed -->
      <section class="lg:col-span-3 space-y-12 order-1 lg:order-2">
        
        <div class="pb-6 border-b border-skin-line">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">
            Diário de Escrita & Notas
          </h1>
          <p class="text-base leading-relaxed opacity-90">
            Meu espaço pessoal para registrar a evolução das minhas histórias, ideias, opiniões e novidades.
          </p>
        </div>

        <div class="space-y-10">
          {allPosts.map((post) => {
            const pubDate = new Date(post.data.pubDatetime);
            const formattedDate = pubDate.toLocaleDateString('pt-BR', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });

            return (
              <article class="pb-8 border-b border-skin-line/50 last:border-none">
                <header class="mb-3">
                  <h2 class="text-2xl font-bold hover:text-skin-accent transition-colors">
                    <a href={getRelativeLocaleUrl(locale, `posts/${post.id}`)}>
                      {post.data.title}
                    </a>
                  </h2>
                  <div class="text-xs uppercase tracking-wider opacity-70 mt-1 font-mono">
                    {formattedDate} {post.data.author ? `— por ${post.data.author}` : ''}
                  </div>
                </header>

                <div class="prose prose-invert max-w-none text-sm leading-relaxed opacity-90 mb-4">
                  <p>{post.data.description}</p>
                </div>

                <footer>
                  <a 
                    href={getRelativeLocaleUrl(locale, `posts/${post.id}`)}
                    class="inline-flex items-center text-xs font-semibold text-skin-accent hover:underline"
                  >
                    Continuar a ler &rarr;
                  </a>
                </footer>
              </article>
            );
          })}
        </div>

      </section>

    </div>
  </main>

  <Footer />
</Layout>
