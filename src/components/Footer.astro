---
import Socials from "./Socials.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={[{ "aria-label": "Site Footer" }, { "mt-auto": !noMarginTop }]}>
  <div class="footer-wrapper app-layout">
    <Socials centered />
    <div class="copyright-wrapper">
      <span>Copyright &#169; {currentYear}</span>
      <span class="separator">&nbsp;|&nbsp;</span>
      <span>Gabriel Canalli Barbosa. Todos os direitos reservados.</span>
    </div>
  </div>
</footer>

<style>
  footer {
    @apply w-full border-t border-skin-line py-6;
  }
  .footer-wrapper {
    @apply flex flex-col items-center justify-between gap-2 sm:flex-row-reverse sm:py-4;
  }
  .copyright-wrapper {
    @apply flex flex-col items-center whitespace-nowrap text-sm text-skin-base sm:flex-row;
  }
  .separator {
    @apply hidden sm:inline;
  }
</style>
