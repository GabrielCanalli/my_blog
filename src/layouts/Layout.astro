---
import config from "@/config";
import "@/styles/global.css";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
}

const {
  title = config.site.title,
  author = config.site.author,
  profile = config.site.profile,
  description = config.site.desc,
  ogImage = config.site.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = true,
} = Astro.props;

const socialImageURL = new URL(
  ogImage ?? config.site.ogImage ?? "og.png",
  Astro.url.origin
).href;
---

<!doctype html>
<html
  lang={config.site.lang ?? "pt-BR"}
  class={`${scrollSmooth ? "scroll-smooth" : ""}`}
  data-theme="dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- FAVICON -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>

    <!-- Google Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <script is:inline src="/toggle-theme.js"></script>
  </head>
  <body class="bg-skin-fill text-skin-base selection:bg-skin-accent selection:text-skin-inverted">
    <slot />
  </body>
</html>
